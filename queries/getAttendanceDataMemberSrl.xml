<query id="getAttendanceDataMemberSrl" action="select">
    <tables>
        <table name="attendance" />
    </tables>
    <columns>
        <column name="substr(regdate,1,8)" alias="regdate" />
        <column name="attendance_srl" alias="attendance_srl" />
        <column name="a_continuity" alias="continuity" />
    </columns>
    <conditions>
		<condition operation="equal" column="member_srl" var="member_srl" />
    </conditions>
    <navigation>
        <index var="sort_index" default="attendance_srl" order="desc" />
    </navigation>
</query>
